# Example only. Not installed/enabled by development or by main SPN startup.
[Unit]
Description=Isolated SPN partner staging HTTP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spn-partner
Group=spn-partner
WorkingDirectory=/opt/spn-partner
Environment=PYTHON_DOTENV_DISABLED=1
ExecStart=/opt/spn-partner/.venv/bin/python scripts/partner_runtime.py --config /etc/spn-partner/staging.json --serve --port 8966
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/spn-partner
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
