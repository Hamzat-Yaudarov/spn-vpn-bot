#!/usr/bin/expect -f
# Password is read before connecting, never passed in argv/env or logged.
set timeout 120
if {[llength $argv] == 1} {
    set passwordFile [lindex $argv 0]
    file lstat $passwordFile attributes
    if {$attributes(type) ne "file" || ($attributes(mode) & 0777) != 0600 || $attributes(uid) != [exec id -u]} {exit 2}
    set handle [open $passwordFile r]
    set password [string trimright [read $handle] "\r\n"]
    close $handle
    file delete $passwordFile
} else {
stty -echo
send_user "VPS password (hidden): "
expect_user {
    -re {([^\r\n]+)[\r\n]+} {set password $expect_out(1,string)}
    timeout {stty echo; send_user "Password input timed out\n"; exit 2}
    eof {stty echo; send_user "Password input closed\n"; exit 2}
}
stty echo
send_user "\n"
}
log_user 0
set connector [file normalize [file join [file dirname [info script]] physical-connect.py]]
set proxy "[auto_execok python3] $connector"
spawn ssh -M -S /private/tmp/spn-node75-physical.sock -o "ProxyCommand=$proxy" -o StrictHostKeyChecking=yes -o HostKeyAlgorithms=ssh-ed25519 -o ConnectTimeout=10 -o NumberOfPasswordPrompts=1 -o PreferredAuthentications=password -o PubkeyAuthentication=no -o ServerAliveInterval=15 root@177.3.250.75 {printf 'SPN_NODE75_AUTHENTICATED\n'; sleep 7200}
set timeout 20
expect {
    -re {root@177\.3\.250\.75's password:} {send -- "$password\r"; unset password}
    timeout {unset password; send_user "SSH prompt timed out\n"; exit 3}
    eof {unset password; send_user "SSH ended before password prompt\n"; exit 4}
}
expect {
    "SPN_NODE75_AUTHENTICATED" {send_user "SSH authenticated; control connection ready\n"}
    -re {Permission denied|Authentication failed} {send_user "SSH authentication rejected\n"; exit 5}
    timeout {send_user "SSH authentication timed out\n"; exit 6}
    eof {send_user "SSH ended during authentication\n"; exit 7}
}
set timeout -1
expect eof
