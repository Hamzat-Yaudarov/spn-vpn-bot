#!/usr/bin/expect -f
# Password is read from the terminal, never stored in this file or argv.
set timeout 30
set state /private/tmp/spn-vkde.ThYH5b
if {![file isfile "$state/known_hosts"]} {exit 2}
stty -echo
send_user "VPS password (hidden): "
expect_user -re {([^\r\n]+)\r?\n}
set password $expect_out(1,string)
stty echo
send_user "\n"
log_user 0
spawn ssh -M -S "$state/ssh" -o "UserKnownHostsFile=$state/known_hosts" -o StrictHostKeyChecking=yes -o ConnectTimeout=20 -o NumberOfPasswordPrompts=1 -o HostKeyAlgorithms=ssh-ed25519 -o ServerAliveInterval=15 root@152.234.235.106 {printf 'SPN_VK_DE_AUTHENTICATED\n'; sleep 3600}
expect {
    -re {root@152\.234\.235\.106's password:} {send -- "$password\r"; unset password}
    timeout {unset password; send_user "SSH prompt timeout\n"; exit 3}
    eof {unset password; send_user "SSH ended before authentication\n"; exit 4}
}
expect {
    "SPN_VK_DE_AUTHENTICATED" {send_user "SSH authenticated with pinned host key\n"}
    timeout {send_user "SSH authentication timeout\n"; exit 5}
    eof {send_user "SSH authentication ended\n"; exit 6}
}
set timeout -1
expect eof
