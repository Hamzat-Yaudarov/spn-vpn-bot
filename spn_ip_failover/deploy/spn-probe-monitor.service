[Unit]
Description=Way SPN authenticated VPN health snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=spnprobe
Group=spnprobe
WorkingDirectory=/opt/wayspn
UMask=0077
ExecStart=/usr/bin/python3 -B -m spn_ip_failover.monitor --config /var/lib/spn-probe/routes.json --output /var/lib/spn-probe/latest.json
TimeoutStartSec=10min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/spn-probe
